{
  "name": "get_linkedin_profiles",
  "title": "Get LinkedIn Profiles",
  "description": "Retrieve a bounded batch of known profiles, with a separate outcome for every input. Email discovery is off unless explicitly requested and adds cost; resume existing results instead of restarting the batch.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "max_cost_usd": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10,
        "description": "Optional per-invocation Apify charge cap. Omission uses owner default_max_cost_usd; a lower cap is allowed. Raising the default requires owner allow_budget_override=true and must stay within hard_max_cost_usd (catalog maximum $10). Reject disallowed or insufficient budgets before paid work; never clamp or increase them. Child reservations must fit the resolved total. Excludes separately billed Typenode usage; repeating acquisition can spend again."
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Maximum normalized records returned now; reading remaining collected rows does not start another scrape.",
        "default": 25
      },
      "linkedin_profile_urls": {
        "$ref": "#/$defs/profile_urls"
      },
      "include_email": {
        "type": "boolean",
        "default": false,
        "description": "Opt into independent provider email discovery and its higher profile charge. Availability and verification remain source-qualified."
      }
    },
    "required": [
      "linkedin_profile_urls"
    ],
    "additionalProperties": false,
    "title": "Get LinkedIn Profiles Input",
    "$defs": {
      "profile_urls": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/profile_url"
        },
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "description": "Known profile targets; encoded URLs remain encoded."
      },
      "profile_url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "description": "LinkedIn person URL, including public or encoded identifiers. An encoded URL is not a public slug.",
        "format": "uri"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": "1.0"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Tool that assembled this packet.",
            "enum": [
              "find_linkedin_company_pages",
              "get_linkedin_company_employee_counts",
              "search_linkedin_company_employees",
              "search_linkedin_company_employees_shared",
              "get_linkedin_profile",
              "get_linkedin_profiles",
              "search_linkedin_jobs",
              "list_linkedin_company_jobs",
              "get_linkedin_job",
              "search_linkedin_posts",
              "get_linkedin_posts",
              "list_linkedin_posts_by_profile",
              "list_linkedin_comments_by_profile",
              "list_linkedin_reactions_by_profile",
              "list_linkedin_post_commenters",
              "list_linkedin_post_reactors",
              "search_linkedin_people",
              "search_linkedin_companies",
              "get_linkedin_companies",
              "list_linkedin_posts_by_company",
              "search_linkedin_company_employees_batch",
              "get_linkedin_account_datasets",
              "get_linkedin_post_engagement_datasets",
              "read_linkedin_discovery_results"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Retrieval observation status, not workflow deployment state.",
            "enum": [
              "success"
            ]
          },
          "effective_request": {
            "type": "object",
            "additionalProperties": true,
            "description": "Canonical safe request with resolved defaults; acquisitions include resolved max_cost_usd after valid budget resolution. Reader arguments do not acquire a new budget. Never credentials or private raw provider configuration."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/source_observation"
            },
            "maxItems": 12
          },
          "cost": {
            "$ref": "#/$defs/cost"
          },
          "coverage": {
            "$ref": "#/$defs/coverage"
          },
          "pagination": {
            "$ref": "#/$defs/pagination"
          },
          "error": {
            "type": "null"
          },
          "receipts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/receipt"
            },
            "maxItems": 12
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/target_outcome"
            },
            "maxItems": 25
          }
        },
        "required": [
